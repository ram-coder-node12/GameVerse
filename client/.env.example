# GameVerse Client Environment Configuration
# Local Development:
VITE_API_URL=http://localhost:8084
VITE_SOCKET_URL=http://localhost:8084

# Production Deployment (Vercel):
# Set VITE_API_URL to your deployed Render backend URL (e.g. https://your-backend.onrender.com)
# Both Axios and Socket.IO will automatically use VITE_API_URL if VITE_SOCKET_URL is omitted.

